#!/bin/bash
# Saves this cursor-agent call's stderr to a per-call file, then replays it to stderr. No sandbox change.
# (v2: no tee/process substitution - a lingering worker-server inheriting the tee pipe kept the
#  caller's stderr pipe open and made calls hang until timeout.)
D="${CURSOR_LLM_SANDBOX:-/tmp}/stderr"; mkdir -p "$D"
F="$D/$(date +%Y%m%dT%H%M%S%N)-$$.stderr"; echo "argv-model: $(printf '%s\n' "$@" | grep -A1 -x -- --model | tail -1)" > "$F"
"${CURSOR_ERRLOG_REAL:-$HOME/.local/bin/cursor-agent}" "$@" 2>>"$F" </dev/null
rc=$?; echo "exit=$rc" >> "$F"; tail -n +2 "$F" >&2; exit $rc
